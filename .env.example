# Optional Drizzle/PostgreSQL schema work (not wired into the active API adapter yet)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/evoting_demo

# Browser API base: leave empty for local Vite proxy; set the API origin for separately deployed portals.
VITE_API_BASE_URL=

# Cross-portal navigation; override these with your deployed portal URLs.
VITE_ADMIN_URL=http://localhost:5173
VITE_VOTER_URL=http://localhost:5174
VITE_CANDIDATE_URL=http://localhost:5175
VITE_EXPLORER_URL=http://localhost:5176

# Configure this on the API host to allow the deployed frontend origins.
# ALLOWED_ORIGINS=https://admin.example.com,https://voter.example.com,https://candidate.example.com,https://explorer.example.com

# Optional current libSQL/Turso adapter settings
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
