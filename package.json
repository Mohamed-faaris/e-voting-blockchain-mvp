    "typecheck:legacy": "pnpm --filter @evoting/api typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7"
  }
