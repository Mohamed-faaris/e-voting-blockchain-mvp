{
  "name": "@evoting/api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @evoting/database build && node --env-file=../../.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "pnpm --filter @evoting/database build && node --env-file=../../.env dist/server.js",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@evoting/database": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.12",
    "@libsql/client": "^0.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}