{
  "name": "@evoting/api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PUBLIC_DIR=../../public tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "PUBLIC_DIR=../../public node dist/server.js",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "predev": "pnpm --filter @evoting/database build",
    "prestart": "pnpm --filter @evoting/database build"
  },
  "dependencies": {
    "@evoting/database": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}