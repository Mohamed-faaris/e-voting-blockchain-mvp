{
  "name": "@evoting/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DB_PATH=../../data/voting-demo.sqlite PUBLIC_DIR=../../public tsx watch src/server.ts",
